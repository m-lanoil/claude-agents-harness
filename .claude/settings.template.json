{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --project <YOUR_PROJECT_ROOT>/servers/system_monitor run python <YOUR_PROJECT_ROOT>/servers/system_monitor/health_check_hook.py 2>/dev/null || true",
            "statusMessage": "Running system health check..."
          },
          {
            "type": "command",
            "command": "uv --project <YOUR_PROJECT_ROOT>/servers/system_monitor run python <YOUR_PROJECT_ROOT>/servers/system_monitor/claude_md_reminder_hook.py 2>/dev/null || true",
            "statusMessage": "Loading session reminders..."
          }
        ]
      }
    ]
  }
}
